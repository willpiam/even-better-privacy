# Copy to .env.pqpost-mail.local in the repository root (gitignored).
# Both mail test tasks load it before the optional root .env.
EBP_KEY_SERVER=http://127.0.0.1:8789
MAIL_HOST=mail.pqpost.com
STALWART_ADMIN_URL=https://mail.pqpost.com
STALWART_ADMIN_TOKEN=
# Generate a separate test secret, for example: openssl rand -hex 32
MAIL_E2E_SECRET=
# server:pqpost-mail-test forces test.pqpost.com, a dedicated SQLite database,
# and automatic domain-ID lookup, regardless of production .env settings.

# Optional paid-address checkout on Ethereum Sepolia and Cardano Preview.
# Fill these with testnet-only values before setting MAIL_PAYMENT_ENABLED=true.
MAIL_PAYMENT_ENABLED=false
MAIL_PAYMENT_PRICES_CENTS={"3":600,"4":500,"5":400,"6":300,"7":200,"8":100}
# JSON array: only ethereum-sepolia and cardano-preview are accepted for this domain.
# Include testnet receiving addresses, native units or verified test-token IDs, and decimals.
# Example: [{"network":"ethereum-sepolia","symbol":"ETH","recipient":"<sepolia-address>","unit":"native","decimals":18},{"network":"cardano-preview","symbol":"ADA","recipient":"<preview-address>","unit":"lovelace","decimals":6}]
MAIL_PAYMENT_ASSETS=
MAIL_PAYMENT_ETH_RPC_URL=
MAIL_PAYMENT_BLOCKFROST_KEY=
MAIL_PAYMENT_COINGECKO_KEY=
