{
  "imports": {
    "@noble/post-quantum": "jsr:@noble/post-quantum@^0.5.4",
    "@noble/post-quantum/ml-dsa": "jsr:@noble/post-quantum@^0.5.4/ml-dsa.js",
    "@noble/post-quantum/ml-kem": "jsr:@noble/post-quantum@^0.5.4/ml-kem.js",
    "@noble/post-quantum/slh-dsa": "jsr:@noble/post-quantum@^0.5.4/slh-dsa.js",
    "@noble/hashes": "jsr:@noble/hashes@^1.8.0",
    "@noble/hashes/hkdf": "jsr:@noble/hashes@^1.8.0/hkdf",
    "@noble/hashes/sha2": "jsr:@noble/hashes@^1.8.0/sha2",
    "@noble/hashes/utils": "jsr:@noble/hashes@^1.8.0/utils",
    "@noble/hashes/pbkdf2": "jsr:@noble/hashes@^1.8.0/pbkdf2",
    "@noble/hashes/argon2": "jsr:@noble/hashes@^1.8.0/argon2",
    "@noble/ciphers": "jsr:@noble/ciphers@^1.3.0",
    "@noble/ciphers/aes": "jsr:@noble/ciphers@^1.3.0/aes",
    "@std/cli/parse-args": "jsr:@std/cli@^1.0.28/parse-args",
    "bech32": "npm:bech32@^2.0.0",
    "imapflow": "npm:imapflow@1.2.12",
    "mailparser": "npm:mailparser@3.9.3",
    "nodemailer": "npm:nodemailer@^6.10.1",
    "postgres": "jsr:@db/postgres@^0.19.5",
    "sqlite": "jsr:@db/sqlite@^0.13.0",
    "std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "std/http/status": "jsr:@std/http@^1.0.20/status"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "cli": "deno run --allow-read --allow-write --allow-env --allow-net ./cli/main.ts",
    "server": "deno run --allow-sys --allow-net --allow-read --allow-write --allow-env --allow-ffi ./server/main.ts",
    "server:remote": "deno task server",
    "postgres": "sh -c 'if docker ps -a --format \"{{.Names}}\" | grep -q \"^ebp-postgres$\"; then docker start ebp-postgres >/dev/null 2>&1 || true; else docker run -d --name ebp-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=ebp -p 55432:5432 postgres:16-alpine; fi'",
    "gui:local-backend": "deno run --allow-read=.,$HOME/.ebp,$HOME/Downloads --allow-write=$HOME/.ebp,$HOME/Downloads --allow-env=HOME,USERPROFILE,GUI_BACKEND_HOST,GUI_BACKEND_PORT,EBP_GUI_BACKEND_EXTENSION_ORIGIN,GUI_SIGN_CONFIRM_BYPASS,MAIL_PARSE_MAX_BYTES,MAIL_OAUTH_GMAIL_CLIENT_ID,MAIL_OAUTH_OUTLOOK_CLIENT_ID,ETHEREAL_API,ETHEREAL_WEB,ETHEREAL_API_KEY,ETHEREAL_CACHE,NODE_V8_COVERAGE,NODE_DEBUG_NATIVE,NODE_DISABLE_COMPILE_CACHE,NODE_COMPILE_CACHE_PORTABLE,NODE_COMPILE_CACHE,DB_TYPE,DB_BACKEND,PG_HOST,PG_PORT,PG_USER,PG_PASSWORD,PG_DATABASE,PG_POOL_SIZE,SMTP_HOST,SMTP_PORT,SMTP_USER,SMTP_PASS,SMTP_FROM,SMTP_SECURE,PUBLIC_BASE_URL,TEST_EMAIL_ONE,TEST_EMAIL_ONE_PWORD,TEST_EMAIL_ONE_SMTP_PORT,TEST_EMAIL_ONE_SMTP_HOST,TEST_EMAIL_ONE_IMAP_PORT,TEST_EMAIL_ONE_IMAP_HOST,TEST_EMAIL_TWO,TEST_EMAIL_TWO_PWORD,TEST_EMAIL_TWO_SMTP_PORT,TEST_EMAIL_TWO_SMTP_HOST,TEST_EMAIL_TWO_IMAP_PORT,TEST_EMAIL_TWO_IMAP_HOST --allow-net --allow-run=xdg-open,gio,sensible-browser,open,rundll32,powershell --allow-sys=hostname,networkInterfaces ./gui/local-backend/main.ts",

    "gui": "deno run --unstable-worker-options --allow-read=.,$HOME/.ebp,$HOME/Downloads --allow-write=$HOME/.ebp,$HOME/Downloads --allow-env=HOME,USERPROFILE,GUI_BACKEND_HOST,GUI_BACKEND_PORT,EBP_GUI_BACKEND_EXTENSION_ORIGIN,GUI_SIGN_CONFIRM_BYPASS,MAIL_PARSE_MAX_BYTES,MAIL_OAUTH_GMAIL_CLIENT_ID,MAIL_OAUTH_OUTLOOK_CLIENT_ID,ETHEREAL_API,ETHEREAL_WEB,ETHEREAL_API_KEY,ETHEREAL_CACHE,NODE_V8_COVERAGE,NODE_DEBUG_NATIVE,NODE_DISABLE_COMPILE_CACHE,NODE_COMPILE_CACHE_PORTABLE,NODE_COMPILE_CACHE,DB_TYPE,DB_BACKEND,PG_HOST,PG_PORT,PG_USER,PG_PASSWORD,PG_DATABASE,PG_POOL_SIZE,SMTP_HOST,SMTP_PORT,SMTP_USER,SMTP_PASS,SMTP_FROM,SMTP_SECURE,PUBLIC_BASE_URL,TEST_EMAIL_ONE,TEST_EMAIL_ONE_PWORD,TEST_EMAIL_ONE_SMTP_PORT,TEST_EMAIL_ONE_SMTP_HOST,TEST_EMAIL_ONE_IMAP_PORT,TEST_EMAIL_ONE_IMAP_HOST,TEST_EMAIL_TWO,TEST_EMAIL_TWO_PWORD,TEST_EMAIL_TWO_SMTP_PORT,TEST_EMAIL_TWO_SMTP_HOST,TEST_EMAIL_TWO_IMAP_PORT,TEST_EMAIL_TWO_IMAP_HOST --allow-net --allow-run=xdg-open,gio,sensible-browser,open,rundll32,powershell --allow-sys=hostname,networkInterfaces ./gui/local-backend/main.ts",
    "gui:open": "sh -c 'deno task gui & gui_pid=$!; sleep 0.5; url=\"http://${GUI_BACKEND_HOST:-127.0.0.1}:${GUI_BACKEND_PORT:-8787}\"; xdg-open \"$url\" >/dev/null 2>&1 || true; wait $gui_pid'",
    "desktop:backend:dev": "deno run --allow-run --allow-read --allow-write --allow-env ./scripts/build_desktop_backend_sidecar.ts",
    "desktop:backend:build": "deno run --allow-run --allow-read --allow-write --allow-env ./scripts/build_desktop_backend_sidecar.ts",
    "test:cli-utils": "deno test --allow-read --allow-write ./cli/tests",
    "test:core": "deno test ./test",
    "test:server": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run --allow-ffi ./server/tests/psql_test_runner.ts",
    "test:gui-backend": "deno test --allow-read --allow-write --allow-env --allow-net --allow-sys=hostname ./gui/local-backend/tests",
    "lint:website-csp": "deno run --allow-read ./scripts/lint_website_csp.ts",
    "lint:docker-base": "deno run --allow-read ./scripts/lint_docker_base.ts",
    "lint:release-artifacts": "deno run --allow-read ./scripts/check_release_artifacts.ts",
    "lint:playwright-dev": "deno run --allow-read ./scripts/lint_playwright_dev_dependency.ts",
    "lint:build-scripts": "deno run --allow-read ./scripts/lint_build_scripts.ts",
    "security:gitleaks": "./scripts/run_gitleaks_scan.sh",
    "release:manifest": "deno run --allow-read ./scripts/release_manifest.ts",
    "test:e2e": "deno run -A npm:@playwright/test@1.58.2 test ./gui/e2e --headed --reporter=line",
    "test:e2e:psql": "./scripts/e2e-with-postgres.sh",
    "test:e2e:inspect": "PWDEBUG=1 deno run -A npm:@playwright/test@1.58.2 test gui/e2e/identity.spec.ts --headed",
    "test:e2e:mobile": "./scripts/mobile-e2e.sh",
    "test:e2e:mobile:smoke": "./scripts/mobile-e2e.sh ./mobile/e2e/smoke.yaml",
    "test:e2e:mobile:fast": "./scripts/mobile-e2e.sh ./mobile/e2e/smoke.yaml ./mobile/e2e/identity.yaml",
    "unsafe:purge:all": "deno run --allow-read --allow-write --allow-env --allow-net ./scripts/postgres/reset-database.ts",
    "query:prod:identities": "deno run -A scripts/postgres/list-identities.ts",
    "query:prod:proposals": "deno run -A scripts/postgres/list-proposals.ts --omit-certificate",
    "query:prod:all": "deno run -A scripts/postgres/list-all.ts --truncate-long-values"
  }
}
