{
  "imports": {
    "@noble/post-quantum": "jsr:@noble/post-quantum@^0.5.2",
    "@noble/hashes": "jsr:@noble/hashes@^1.8.0",
    "@noble/ciphers": "jsr:@noble/ciphers@^1.2.1",
    "@std/cli/parse-args": "jsr:@std/cli@^1.0.6/parse-args",
    "postgres": "https://deno.land/x/postgres@v0.17.0/mod.ts",
    "sqlite": "https://deno.land/x/sqlite@v3.9.1/mod.ts",
    "std/dotenv": "https://deno.land/std@0.224.0/dotenv/mod.ts",
    "std/http/server": "https://deno.land/std@0.224.0/http/server.ts",
    "std/http/status": "https://deno.land/std@0.224.0/http/status.ts"
  },
  "tasks": {
    "cli": "deno run --allow-read --allow-write --allow-env --allow-net ./cli/main.ts",
    "server": "deno run --allow-net --allow-read --allow-write --allow-env ./server/main.ts",
    "server:remote": "deno task server",
    "postgres": "sh -c 'if docker ps -a --format \"{{.Names}}\" | grep -q \"^ebp-postgres$\"; then docker start ebp-postgres >/dev/null 2>&1 || true; else docker run -d --name ebp-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=ebp -p 55432:5432 postgres:16-alpine; fi'",
    "gui:local-backend": "deno run --allow-read --allow-write --allow-env --allow-net ./gui/local-backend/main.ts",
    "gui": "deno run --allow-read --allow-write --allow-env --allow-net ./gui/local-backend/main.ts",
    "test:cli-utils": "deno test --allow-read --allow-write ./cli/tests",
    "test:core": "deno test ./test",
    "test:server": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run ./server/tests/psql_test_runner.ts",
    "test:gui-backend": "deno test --allow-read --allow-write --allow-env --allow-net ./gui/local-backend/tests",
    "test:e2e": "npm run test:e2e",
    "test:e2e:psql": "./scripts/e2e-with-postgres.sh",
    "test:e2e:inspect": "PWDEBUG=1 npx playwright test gui/e2e/identity.spec.ts --headed"
  }
}
