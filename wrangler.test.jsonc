{
  // Deploy the test checkout and its web hostname together.
  "name": "pqpost-test-checkout",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "test.pqpost.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./website",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
