{
  "build": {
    "beforeDevCommand": "deno task -c ../deno.json desktop:backend:dev",
    "beforeBuildCommand": "deno task -c ../deno.json desktop:backend:build",
    "devPath": "http://127.0.0.1:8787/",
    "distDir": "../dist"
  },
  "package": {
    "productName": "EBP",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      }
    },
    "windows": [
      {
        "title": "Even Better Privacy",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "bundle": {
      "active": true,
      "targets": "appimage",
      "identifier": "com.ebp.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": ["bin/ebp-gui-backend"]
    }
  }
}
