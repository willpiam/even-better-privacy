{
  "manifest_version": 3,
  "name": "EBP Mail",
  "version": "0.0.1",
  "description": "Encrypt/decrypt EBP messages in supported webmail via the local EBP backend.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mail.proton.me/*",
    "https://mail.protonmail.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office365.com/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://mail.proton.me/*",
        "https://mail.protonmail.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office365.com/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_page": "options.html"
}
