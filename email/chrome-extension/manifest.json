{
  "manifest_version": 3,
  "name": "EBP Mail",
  "version": "0.1.0",
  "description": "Encrypt/decrypt EBP messages in supported webmail via the local EBP backend.",
  "icons": {
    "16": "tiny-logo.png",
    "32": "tiny-logo.png",
    "48": "tiny-logo.png",
    "128": "tiny-logo.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mail.proton.me/*",
    "https://mail.protonmail.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office365.com/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EBP Mail",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://mail.proton.me/*",
        "https://mail.protonmail.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office365.com/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_page": "options.html"
}
